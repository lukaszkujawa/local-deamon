# LLM Model Configuration
# Format: provider/model-name
# Examples:
#   - openai/gpt-4o
#   - openai/gpt-4-turbo
#   - anthropic/claude-3-5-sonnet-20241022
#   - ollama/llama3:latest
AGENT_LLM_MODEL=openai/gpt-4o

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: for OpenAI-compatible APIs
# OPENAI_TEMPERATURE=0.15  # Lower = more focused, higher = more creative (default: 0.7)

# Anthropic Configuration
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# ANTHROPIC_TEMPERATURE=0.15  # Lower = more focused, higher = more creative (default: 0.7)

# Ollama Configuration (for local models)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TEMPERATURE=0.25
# OLLAMA_NUM_CTX=32000
# OLLAMA_NUM_BATCH=1024

# Microservice Configuration
# Scraper Service (required for web scraping)
HOST_GET_URL=http://127.0.0.1:8000
# SCRAPER_FETCH_TIMEOUT_MS=15000
# SCRAPER_NETWORK_IDLE_TIMEOUT_MS=5000
# SCRAPER_ENABLE_LAZY_LOAD=true
# SCRAPER_MAX_SCROLL_ATTEMPTS=3

# Search Service (required for web search)
HOST_WEB_SEARCH=http://127.0.0.1:8001
TAVILY_API_KEY=tvly-your-api-key-here  # Get from https://tavily.com
# TAVILY_SEARCH_DEPTH=advanced
# TAVILY_MIN_SCORE=0.0

# General Settings
MAX_TOKENS=4096
SESSION_NAME=default
PROMPT_LOGGING=false
